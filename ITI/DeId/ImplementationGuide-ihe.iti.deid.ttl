       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "ex-Bundle-secondaryUse-pandemicIPS-example-patient" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The Origional FHIR Document provided by the health Data Holder. \nThe following bundle provides an example view of a record that could be in the research cohort for the pandemic patient. \nThere have been no alterations to this original record." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "true"^^xsd:boolean ]
