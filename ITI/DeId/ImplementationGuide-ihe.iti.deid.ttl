       fhir:reference [
         fhir:l <https://profiles.ihe.net/ITI/DeId/Patient/ex-Decedent-pandemicIPS-VRDR-stage-1> ;
         fhir:reference [ fhir:v "Patient/ex-Decedent-pandemicIPS-VRDR-stage-1" ]
       ] ;
