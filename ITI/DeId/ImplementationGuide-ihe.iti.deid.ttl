       ] ;
       fhir:name [ fhir:v "ex-Decedent-pandemicIPS-VRDR" ] ;
       fhir:description [ fhir:v "The following patient resource represents the decedent referenced in the death certificate document bundle. This is the stage 0 version of the patient, where no de-identification has been applied and all direct identifiers are present." ] ;
