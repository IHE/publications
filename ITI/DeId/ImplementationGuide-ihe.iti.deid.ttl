       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "ex-Bundle-DeathCert-pandemicIPS-VRDR-stage-1" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "In addition to pseudonymizing the Decedent Identifiers and Patient name, we are also applying pseudoidentifiers and names for the:\n* Decedent Mother\n* Decedent Father\n* Decedent Spouse\n\nThe indirect identifiers in this record will be addressed during stage 2 de-identification." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "true"^^xsd:boolean ]
     ], [
