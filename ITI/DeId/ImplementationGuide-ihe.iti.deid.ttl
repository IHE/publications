     fhir:resource ( [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "StructureDefinition:resource"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <https://profiles.ihe.net/ITI/DeId/StructureDefinition/IHE.BasicAudit.DeIdentification.Source> ;
         fhir:reference [ fhir:v "StructureDefinition/IHE.BasicAudit.DeIdentification.Source" ]
       ] ;
       fhir:name [ fhir:v "Audit Event for De-Identification at Source" ] ;
       fhir:description [ fhir:v "Defines constraints on the AuditEvent Resource to record when a De-Identification happens at the Source.\nNote that a De-Identification event often impacts many different patients, so many AuditEvent resources need to be created so that each Patient is individually represented. \nThis prevents leakage of other patients' that were also De-Identified at the same time.\n\n- Export event\n- subtype of deidentify or pseudonymize\n- shall have source of itself\n- shall have a source agent\n- should have a recipient agent(s) if known\n- may have user, app, organization agent(s)\n  - combine with the Security Token pattern\n- should have the custodian that released the data\n- should have the authorizer that represented the patient (may be the patient)\n- shall have a patient entity\n- may have the consent that authorized the de-identification\n- may have the authorizing client token (saml, jwt, etc)\n- may have the set of data entity(ies)" ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "ValueSet"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <https://profiles.ihe.net/ITI/DeId/ValueSet/IHE.BasicAudit.DeIdentification.Subtype> ;
         fhir:reference [ fhir:v "ValueSet/IHE.BasicAudit.DeIdentification.Subtype" ]
       ] ;
       fhir:name [ fhir:v "Audit Event Subtype for De-Identification" ] ;
       fhir:description [ fhir:v "Defines the AuditEvent Subtype for De-Identification events.\nThis is used to indicate that the AuditEvent is specifically for a De-Identification event.\nThe code is based on the ISO 21089 lifecycle code for de-identification." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
