       fhir:reference [
         fhir:l <https://profiles.ihe.net/ITI/DeId/Bundle/78f68a27-c439-4cd5-9ca2-ebc882468ade> ;
         fhir:reference [ fhir:v "Bundle/78f68a27-c439-4cd5-9ca2-ebc882468ade" ]
       ] ;
       fhir:name [ fhir:v "ex-Bundle-DeathCert-pandemicIPS-VRDR" ] ;
       fhir:description [ fhir:v "The following bundle reflects a complete death certificate record, including:\n* the decedent demographics, including death date/time,\n* their next-of-kin demographics,\n* coded cause of death information,\n* coded usual occupation and associated usual industry,\n* death pronouncer,\n* death certifier,\n* funeral home information, and\n* burial information." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v true
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "Bundle"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <https://profiles.ihe.net/ITI/DeId/Bundle/e817cefe-a7c4-487a-8116-be23cf865f3f> ;
         fhir:reference [ fhir:v "Bundle/e817cefe-a7c4-487a-8116-be23cf865f3f" ]
       ] ;
       fhir:name [ fhir:v "ex-Bundle-DeathCert-pandemicIPS-VRDR-stage-1" ] ;
       fhir:description [ fhir:v "In addition to pseudonymizing the Decedent Identifiers and Patient name, we are also applying pseudoidentifiers and names for the:\n* Decedent Mother\n* Decedent Father\n* Decedent Spouse\n\nThe indirect identifiers in this record will be addressed during stage 2 de-identification." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v true
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "Bundle"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <https://profiles.ihe.net/ITI/DeId/Bundle/fc7b32fe-13b1-42e9-bca1-ff805587d072> ;
         fhir:reference [ fhir:v "Bundle/fc7b32fe-13b1-42e9-bca1-ff805587d072" ]
       ] ;
       fhir:name [ fhir:v "ex-Bundle-DeathCert-pandemicIPS-VRDR-stage-2" ] ;
       fhir:description [ fhir:v "The following bundle reflects the sample mortality data after applying the approved de-identification methods to the pseudonymized bundle as described in section IPS Data Element Mappings (FHIR). This shows:\n* Date shifting throughout the bundle (applies to the date of death), and\n* Data omissions, noting the data is omitted in emptyReason as ‘withheld’ at the section level, and as ‘masked’ in dataAbsentReason at the data element level.\n\nThe majority of the death certificate is redacted leaving the remaining data deeded for the study:\n* coded cause of death\n* coded usual occupation and associated usual industry,\n* pseudonymized decedent demographics, including date/time of death" ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v true
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "Bundle"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <https://profiles.ihe.net/ITI/DeId/Bundle/80c516fd-9c84-4924-875b-bf0048979ae1> ;
         fhir:reference [ fhir:v "Bundle/80c516fd-9c84-4924-875b-bf0048979ae1" ]
       ] ;
       fhir:name [ fhir:v "ex-Bundle-secondaryUse-pandemicIPS-example-patient" ] ;
       fhir:description [ fhir:v "The Origional FHIR Document provided by the health Data Holder. \nThe following bundle provides an example view of a record that could be in the research cohort for the pandemic patient. \nThere have been no alterations to this original record." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v true
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "Bundle"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <https://profiles.ihe.net/ITI/DeId/Bundle/430e32bc-be3e-4c42-a17b-461ea4f402d4> ;
         fhir:reference [ fhir:v "Bundle/430e32bc-be3e-4c42-a17b-461ea4f402d4" ]
       ] ;
       fhir:name [ fhir:v "ex-Bundle-secondaryUse-pandemicIPS-example-patient-1-stage-1" ] ;
       fhir:description [ fhir:v "The following bundle provides an example view of the sample patient record after applying pseudonymization. \nThis shows:\n- A pseudo-identifier has been applied to the patient resource and replaces the original patient identifier throughout the document.\n- A pseudo-name has been applied to the patient resource and replaces the original patient name throughout the document. Note that a pseudo-name is required as content is not permitted to be omitted or replaced with a null flavor in FHIR patient resources." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v true
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "Bundle"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <https://profiles.ihe.net/ITI/DeId/Bundle/6603561c-2888-4355-9df4-23675f6eb458> ;
         fhir:reference [ fhir:v "Bundle/6603561c-2888-4355-9df4-23675f6eb458" ]
       ] ;
       fhir:name [ fhir:v "ex-Bundle-secondaryUse-pandemicIPS-example-patient-1-stage-2" ] ;
       fhir:description [ fhir:v "The following bundle provides an example view of the sample patient record after applying the approved de-identification methods to the pseudonymized bundle as described in section IPS Data Element Mappings (FHIR). \nThis shows:\n- Date shifting throughout the bundle (e.g. dates associated with problems, procedures, medications, immunizations, allergies, etc.)\n- The Patient's birthdate has been date-shifted forward by 107 days.\n- Data omissions, noting the data is omitted in emptyReason as ‘withheld’ at the section level, and as ‘masked’ in dataAbsentReason at the data element level." ] ;
       fhir:example [
