<https://profiles.ihe.net/ITI/VHL/Basic/ProvideVHL> a fhir:Basic ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "ProvideVHL"] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Requirements ProvideVHL</b></p><a name=\"ProvideVHL\"> </a><a name=\"hcProvideVHL\"> </a><p>These requirements apply to the actor <a href=\"ActorDefinition-VHLHolder.html\">VHL Holder</a></p><table class=\"grid\"><tr><td><b><a name=\"transmit-vhl\"> </a></b>Transmit VHL</td><td>SHALL</td><td><div><p>This transaction SHALL support at least one rendering and transmission mechanism to accommodate the use cases and deployment scenario, including:</p>\n<ul>\n<li>QR codes displayed on mobile devices or printed materials</li>\n<li>Deep links shared via secure messaging or email</li>\n</ul>\n</div></td></tr></table></div>"^^rdf:XMLLiteral ]
  ] ; # 
