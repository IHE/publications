  <id value="TestPlan-QRCodeFlow"/>
  <extension url="http://hl7.org/fhir/5.0/StructureDefinition/extension-TestPlan.url">
    <valueUri value="https://profiles.ihe.net/ITI/VHL/TestPlan/TestPlan-QRCodeFlow"/>
  </extension>
