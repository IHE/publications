           fhir:v "**ITI-YY4 Message Semantics** – Verifies the VHL QR code message format: ISO/IEC 18004:2015\nAlphanumeric mode, HC1: prefix, Base45 encoding, ZLIB/DEFLATE compression, CWT structure\n(protected header: alg/kid, claims: exp/iat/hcert), and VHL payload fields (url/key/flag/exp)."
         ]
       ] [
         fhir:extension ( [
           fhir:url [ fhir:v "http://hl7.org/fhir/5.0/StructureDefinition/extension-TestPlan.testCase.testRun.script.language"^^xsd:anyURI ] ;
