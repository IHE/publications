  <url value="https://profiles.ihe.net/ITI/MHD/StructureDefinition/IHE.MHD.Patch.Parameters"/>
  <version value="4.2.5"/>
  <name value="PatchParameters"/>
  <title value="MHD DocumentReference Patch Parameters"/>
  <status value="active"/>
  <date value="2026-10-18T17:30:08-05:00"/>
  <publisher value="IHE IT Infrastructure Technical Committee"/>
  <contact>
    <telecom>
      <system value="url"/>
