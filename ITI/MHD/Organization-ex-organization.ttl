@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<https://profiles.ihe.net/ITI/MHD/Organization/ex-organization> a fhir:Organization ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "ex-organization"] ;
  fhir:Resource.meta [
     fhir:Meta.security [
       fhir:index 0 ;
       fhir:Coding.system [ fhir:value "http://terminology.hl7.org/CodeSystem/v3-ActReason" ] ;
       fhir:Coding.code [ fhir:value "HTEST" ]
     ]
  ] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Organization ex-organization</b></p><a name=\"ex-organization\"> </a><a name=\"hcex-organization\"> </a><div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\"/><p style=\"margin-bottom: 0px\">Security Label: <a href=\"http://terminology.hl7.org/7.4.0/CodeSystem-v3-ActReason.html\">test health data (Details: ActReason code HTEST = 'test health data')</a></p></div><p style=\"border: 1px #661aff solid; background-color: #e6e6ff; padding: 10px;\">nowhere</p><hr/></div>"
  ] ;
  fhir:Organization.name [ fhir:value "nowhere"] .

# - ontology header ------------------------------------------------------------

<https://profiles.ihe.net/ITI/MHD/Organization/ex-organization.ttl> a owl:Ontology ;
  owl:imports fhir:fhir.ttl .

