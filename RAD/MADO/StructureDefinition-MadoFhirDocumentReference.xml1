        <profile value="https://profiles.ihe.net/RAD/MADO/StructureDefinition/ext-R5-DocumentReference.bodySite"/>
      </type>
      <mustSupport value="true"/>
    </element>
    <element id="DocumentReference.extension:bodysite.value[x]">
      <path value="DocumentReference.extension.value[x]"/>
      <binding>
        <strength value="extensible"/>
        <valueSet value="https://profiles.ihe.net/RAD/MADO/ValueSet/ValueSetAnatomicalRegion"/>
      </binding>
    </element>
    <element id="DocumentReference.extension:modality">
      <path value="DocumentReference.extension"/>
      <sliceName value="modality"/>
      <min value="1"/>
      <max value="*"/>
      <type>
        <code value="Extension"/>
        <profile value="https://profiles.ihe.net/RAD/MADO/StructureDefinition/ext-R5-DocumentReference.modality"/>
      </type>
      <mustSupport value="true"/>
    </element>
    <element id="DocumentReference.masterIdentifier">
      <path value="DocumentReference.masterIdentifier"/>
      <short value="The identifier of the FHIR Imaging Study Manifest."/>
      <definition value="An OID according to the DICOM value representation UI. Note this format is used so the same value is used as the SOP Instance UID of the corresponding DICOM KOS manifest."/>
    </element>
    <element id="DocumentReference.identifier">
      <path value="DocumentReference.identifier"/>
      <min value="1"/>
    </element>
    <element id="DocumentReference.type">
      <path value="DocumentReference.type"/>
      <short value="Kind of document (LOINC if possible), see section 6.X.6 of volume 3."/>
      <min value="1"/>
    </element>
    <element id="DocumentReference.category">
      <path value="DocumentReference.category"/>
      <short value="Categorization of document, see section 6.X.6 of volume 3."/>
      <min value="1"/>
    </element>
    <element id="DocumentReference.subject">
      <path value="DocumentReference.subject"/>
      <min value="1"/>
    </element>
    <element id="DocumentReference.author">
      <path value="DocumentReference.author"/>
      <slicing>
        <discriminator>
          <type value="profile"/>
          <path value="$this.resolve()"/>
        </discriminator>
        <ordered value="false"/>
        <rules value="open"/>
      </slicing>
      <short value="Who and/or what authored the document (i.e. manifest)"/>
    </element>
    <element id="DocumentReference.author:source-organization">
      <path value="DocumentReference.author"/>
      <sliceName value="source-organization"/>
      <short value="The organization that generated the manifest."/>
      <min value="0"/>
      <max value="1"/>
      <type>
        <code value="Reference"/>
        <targetProfile value="https://profiles.ihe.net/RAD/MADO/StructureDefinition/MadoCreatorOrganization"/>
      </type>
    </element>
    <element id="DocumentReference.author:source-device">
      <path value="DocumentReference.author"/>
      <sliceName value="source-device"/>
      <short value="The device that generated the manifest."/>
      <min value="0"/>
      <max value="1"/>
      <type>
        <code value="Reference"/>
        <targetProfile value="https://profiles.ihe.net/RAD/MADO/StructureDefinition/MadoCreator"/>
      </type>
    </element>
    <element id="DocumentReference.authenticator">
      <path value="DocumentReference.authenticator"/>
      <short value="Who/what authenticated the document (i.e. manifest)"/>
    </element>
    <element id="DocumentReference.custodian">
      <path value="DocumentReference.custodian"/>
      <short value="Organization which maintains the document (i.e. manifest)"/>
    </element>
    <element id="DocumentReference.relatesTo">
      <path value="DocumentReference.relatesTo"/>
      <slicing>
        <discriminator>
          <type value="value"/>
          <path value="code"/>
        </discriminator>
        <ordered value="false"/>
        <rules value="open"/>
      </slicing>
    </element>
    <element id="DocumentReference.relatesTo:kos-reference">
      <path value="DocumentReference.relatesTo"/>
      <sliceName value="kos-reference"/>
      <short value="Reference to the DocumentReference resource that contains the DICOM KOS manifest that corresponds to this imaging manifest in FHIR format"/>
      <min value="0"/>
      <max value="1"/>
    </element>
    <element id="DocumentReference.relatesTo:kos-reference.code">
      <path value="DocumentReference.relatesTo.code"/>
      <patternCode value="transforms"/>
    </element>
    <element id="DocumentReference.relatesTo:kos-reference.target">
      <path value="DocumentReference.relatesTo.target"/>
      <type>
        <code value="Reference"/>
        <targetProfile value="https://profiles.ihe.net/RAD/MADO/StructureDefinition/MadoDicomKosDocumentReference"/>
      </type>
    </element>
    <element id="DocumentReference.content">
      <path value="DocumentReference.content"/>
      <short value="Clinical context of the manifest"/>
    </element>
    <element id="DocumentReference.content.extension">
      <path value="DocumentReference.content.extension"/>
      <slicing>
        <discriminator>
          <type value="value"/>
          <path value="url"/>
        </discriminator>
        <ordered value="false"/>
        <rules value="open"/>
      </slicing>
      <min value="1"/>
    </element>
    <element id="DocumentReference.content.extension:profile">
      <path value="DocumentReference.content.extension"/>
      <sliceName value="profile"/>
      <short value="Contains the profile of the referred report"/>
      <min value="1"/>
      <max value="*"/>
      <type>
        <code value="Extension"/>
        <profile value="http://hl7.org/fhir/5.0/StructureDefinition/extension-DocumentReference.content.profile"/>
      </type>
    </element>
    <element id="DocumentReference.content.extension:profile.extension:value">
      <path value="DocumentReference.content.extension.extension"/>
      <sliceName value="value"/>
    </element>
    <element id="DocumentReference.content.extension:profile.extension:value.extension">
      <path value="DocumentReference.content.extension.extension.extension"/>
      <max value="0"/>
    </element>
    <element id="DocumentReference.content.extension:profile.extension:value.value[x]">
      <path value="DocumentReference.content.extension.extension.value[x]"/>
      <slicing>
        <discriminator>
          <type value="type"/>
          <path value="$this"/>
        </discriminator>
        <ordered value="false"/>
        <rules value="open"/>
      </slicing>
    </element>
    <element id="DocumentReference.content.extension:profile.extension:value.value[x]:valueCanonical">
      <path value="DocumentReference.content.extension.extension.value[x]"/>
      <sliceName value="valueCanonical"/>
      <min value="0"/>
      <max value="1"/>
      <type>
        <code value="canonical"/>
      </type>
      <patternCanonical value="https://profiles.ihe.net/RAD/MADO/StructureDefinition/MadoFhirBundle"/>
    </element>
    <element id="DocumentReference.content.attachment.contentType">
      <path value="DocumentReference.content.attachment.contentType"/>
      <patternCode value="application/fhir+json"/>
    </element>
    <element id="DocumentReference.content.attachment.language">
      <path value="DocumentReference.content.attachment.language"/>
      <min value="1"/>
    </element>
    <element id="DocumentReference.content.attachment.creation">
      <path value="DocumentReference.content.attachment.creation"/>
      <min value="1"/>
    </element>
    <element id="DocumentReference.content.format">
      <path value="DocumentReference.content.format"/>
      <min value="1"/>
    </element>
    <element id="DocumentReference.content.format.system">
      <path value="DocumentReference.content.format.system"/>
      <fixedUri value="http://ihe.net/fhir/ihe.formatcode.fhir/CodeSystem/formatcode"/>
    </element>
    <element id="DocumentReference.content.format.code">
      <path value="DocumentReference.content.format.code"/>
      <fixedCode value="urn:ihe:rad:MADO:fhir-manifest:2026"/>
    </element>
    <element id="DocumentReference.context">
      <path value="DocumentReference.context"/>
      <min value="1"/>
    </element>
    <element id="DocumentReference.context.event">
      <path value="DocumentReference.context.event"/>
      <short value="Main clinical acts documented, could include the study procedure codes."/>
    </element>
    <element id="DocumentReference.context.period">
      <path value="DocumentReference.context.period"/>
      <min value="1"/>
    </element>
    <element id="DocumentReference.context.period.start">
      <path value="DocumentReference.context.period.start"/>
      <short value="The start time of the study referred to by the manifest"/>
      <min value="1"/>
    </element>
    <element id="DocumentReference.context.facilityType">
      <path value="DocumentReference.context.facilityType"/>
      <min value="1"/>
    </element>
    <element id="DocumentReference.context.practiceSetting">
      <path value="DocumentReference.context.practiceSetting"/>
      <min value="1"/>
    </element>
    <element id="DocumentReference.context.related">
      <path value="DocumentReference.context.related"/>
      <slicing>
        <discriminator>
          <type value="profile"/>
          <path value="identifier"/>
        </discriminator>
        <ordered value="false"/>
        <rules value="open"/>
      </slicing>
      <min value="1"/>
    </element>
    <element id="DocumentReference.context.related:study-instance-uid">
      <path value="DocumentReference.context.related"/>
      <sliceName value="study-instance-uid"/>
      <short value="The Study Instance UID of the imaging study that is the focus of the imaging manifest, represented as an Identifier with a fixed system and a value that corresponds to the Study Instance UID."/>
      <min value="1"/>
      <max value="1"/>
      <type>
        <code value="Reference"/>
        <profile value="https://profiles.ihe.net/RAD/MADO/StructureDefinition/MadoReferencedStudyInstanceUidIdentifier"/>
        <targetProfile value="http://hl7.org/fhir/StructureDefinition/Resource|4.0.1"/>
      </type>
      <mustSupport value="true"/>
    </element>
    <element id="DocumentReference.context.related:accession-number">
      <path value="DocumentReference.context.related"/>
      <sliceName value="accession-number"/>
      <short value="The Accession Number of the imaging study that is the focus of the imaging manifest, represented as an Identifier with a fixed system and a value that corresponds to the Accession Number."/>
      <min value="0"/>
      <max value="1"/>
      <type>
        <code value="Reference"/>
        <profile value="https://profiles.ihe.net/RAD/MADO/StructureDefinition/MadoReferencedAccessionNumberIdentifier"/>
        <targetProfile value="http://hl7.org/fhir/StructureDefinition/Resource|4.0.1"/>
      </type>
      <mustSupport value="true"/>
    </element>
  </differential>
</StructureDefinition>