      </reference>
      <name value="02A-ClotrimazoleCanifugCremolum"/>
      <description value="2A. Clotrimazole cream 10mg/g and 6 pessaries 100g. Branded packaged product, consisting of different medication items. Defined by attributes."/>
      <exampleCanonical value="https://profiles.ihe.net/PHARM/MEOW/StructureDefinition/IHEMedication"/>
    </resource>
