      </reference>
      <name value="01B-Cefuroxime1500GenericConcept"/>
      <description value="1B. Cefuroxime 1500mg (1.5g) powder for solution in a vial. Generic product, defined by a code system (receiving system is expected to have access to the code system for additional attributes or display names)."/>
      <exampleCanonical value="https://profiles.ihe.net/PHARM/MEOW/StructureDefinition/IHEMedication"/>
    </resource>
