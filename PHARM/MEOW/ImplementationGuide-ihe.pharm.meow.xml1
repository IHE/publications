      <exampleCanonical value="https://profiles.ihe.net/PHARM/MEOW/StructureDefinition/IHEMedication"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="Medication"/>
