      <description value="2A2. Clotrimazole cream (10mg/g, 1 tube of 20g) as part of Canifug Cremolum product (ISO IDMP manufactured item)"/>
      <exampleCanonical value="https://profiles.ihe.net/PHARM/MEOW/StructureDefinition/IHEMedication"/>
    </resource>
